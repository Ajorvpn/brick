<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      P3-T6: the Gate A VpnService is now real. BIND_VPN_SERVICE is the
      framework permission that makes android.net.VpnService.Builder.establish()
      grant a TUN interface; it is system-only, so declaring it is correct and
      does not grant our app anything extra.
    -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      P3-T7: libbox opens real sockets the moment it initialises the `tun`
      inbound. Without INTERNET every socket() returns EACCES, which surfaced
      on-device (SM-A205F, API 29) as:

        proxyerror: initialize inbound/tun[tun-in]:
          listen tcp4 10.111.222.1:0: socket: permission denied

      P3-T6 never declared INTERNET because its FakeTunnelEngine touched no
      network at all; the fake engine masked a genuine platform requirement.
      INTERNET is a normal (install-time) permission: no runtime prompt.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 34+ only; harmless below that. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      P3-T7: `android:name` installs BrickVpnApplication, which is the only
      place `Libbox.setup(SetupOptions)` can be called. Without it sing-box
      resolves its cache file against the process CWD (`/` on Android, read-only)
      and every BoxService.start() fails with:
        proxyerror: pre-start cache file: open cache.db: read-only file system
      It must run before any VpnService, which Application.onCreate guarantees.
    -->
    <application
        android:name=".BrickVpnApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrickVpnHarness">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.BrickVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <!--
              Android 14+ (API 34) requires a subtype whenever specialUse is
              declared. Below API 34 this property is ignored.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
