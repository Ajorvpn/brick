<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: Deep Obsidian background with the app icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#07090F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">#07090F</item>
        <item name="android:navigationBarColor">#07090F</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#07090F</item>
    </style>
</resources>
